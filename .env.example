# Copy this file to `.env.local` and fill in your key. `.env.local` is git-ignored.

# Required: Anthropic API key for the "Ask my AI" chat (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Optional rate limits (defaults shown)
# Messages one visitor can send per 10 minutes
CHAT_LIMIT_PER_10_MIN=8
# Messages one visitor can send per 24 hours
CHAT_LIMIT_PER_DAY=30
# Messages all visitors together can send per 24 hours (caps your daily API spend)
CHAT_GLOBAL_DAILY_LIMIT=500
